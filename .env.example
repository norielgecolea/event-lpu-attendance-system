# Copy to .env and fill in real values:
#   cp .env.example .env

# --- Gate Attendance Postgres (students / employees / RFID — read-only) ---
# IP or hostname of the gate attendance system's database server.
GATE_ATTENDANCE_DB_HOST=192.168.1.50
# Must match the gate system's Postgres credentials (see lpu-gate-attendance-system/.env)
GATE_ATTENDANCE_DB_PORT=5432
GATE_ATTENDANCE_DB_NAME=postgres
GATE_ATTENDANCE_DB_USER=postgres
GATE_ATTENDANCE_DB_PASSWORD=Lpu-1234
# Gate web base URL for photos (http:// or https://)
GATE_ATTENDANCE_URL=http://192.168.1.50

# --- This system's PostgreSQL (events, users, time logs) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# --- Tomcat ---
TOMCAT_PORT=8081
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me

# --- Nginx (optional) ---
# SERVER_NAME=localhost
# Replace data/web/certs/*.pem with real TLS certs for production HTTPS.

# --- App ---
# Base64-encoded 256-bit secret for JWT signing (different from the gate system)
APP_JWT_SECRET=bHB1LWV2ZW50LWF0dGVuZGFuY2Utand0LXNlY3JldC1rZXktMzJieXRlcyE=

# --- Cloudflare Tunnel (optional) ---
CLOUDFLARE_TUNNEL_TOKEN=

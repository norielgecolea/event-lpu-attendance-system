map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP — default port 80
# SERVER_NAME can list multiple hosts (space-separated). Trailing "_" is a catch-all.
server {
    listen       80 default_server;
    listen  [::]:80 default_server;
    server_name  ${SERVER_NAME} _;

    client_max_body_size 250m;

    # Gate photos from the local pictures directory. Fall back to the gate
    # server when a file is missing. GATE_ATTENDANCE_URL has no trailing slash.
    location ^~ /gate-attendance/attendance-system/pictures/ {
        alias /var/gate-pictures/;
        error_page 403 404 = @gate_picture;
    }

    location @gate_picture {
        rewrite ^/gate-attendance/(.*)$ /$1 break;
        proxy_pass ${GATE_ATTENDANCE_URL};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /gate-attendance/ {
        proxy_pass ${GATE_ATTENDANCE_URL}/;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Backend API + WebSocket (Tomcat WAR context)
    location /event-attendance-system/ {
        proxy_pass http://${TOMCAT_HOST}:${TOMCAT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }

    # Angular frontend (dev server) + HMR websocket
    location / {
        proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }
}

# HTTPS — default port 443
server {
    listen       443 ssl default_server;
    listen  [::]:443 ssl default_server;
    server_name  ${SERVER_NAME} _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 250m;

    # Gate photos from the local pictures directory. Fall back to the gate
